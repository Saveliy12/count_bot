# Локальный запуск приложения: этот DSN указывает на PostgreSQL на хосте.
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses?sslmode=disable
HTTP_ADDR=:8083

TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT=20s
TIMEZONE=Europe/Moscow

# Docker Compose: отдельный DSN, внутри сети контейнеров хост называется postgres.
# Если меняешь POSTGRES_* — обнови и COMPOSE_DATABASE_URL.
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_HOST_PORT=55432
APP_HOST_PORT=8083
COMPOSE_DATABASE_URL=postgres://expenses:expenses@postgres:5432/expenses?sslmode=disable
